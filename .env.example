# Campfire free-spec-ads campaign form
# Create a Cloudflare Turnstile widget for your production domain and add its two keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=www.studiotak.co

# Contentsquare tag ID for consented heatmaps and session replays.
NEXT_PUBLIC_CONTENTSQUARE_TAG_ID=5382551060185

# Resend email. RESEND_FROM_EMAIL must use a verified Resend domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Studio Tak <hello@studiotak.co>"
# Optional published Resend template used for the applicant thank-you email.
RESEND_APPLICATION_THANK_YOU_TEMPLATE_ID=

# Attio CRM. Create an API key with People record read/write, object
# configuration read, list configuration read, and list entry read/write access.
ATTIO_API_KEY=
# Existing Attio list for all website form submissions. Defaults to "leads".
ATTIO_WEBSITE_LEADS_LIST=leads

# Meta web Lead events. The dataset ID is your Meta Pixel ID. These settings
# are preferred; if omitted, the site reuses the qualified-leads dataset and
# access token below when both are configured.
META_WEB_EVENTS_DATASET_ID=859420348425587
META_WEB_EVENTS_ACCESS_TOKEN=
META_WEB_EVENTS_API_VERSION=v26.0
# META_WEB_EVENTS_TEST_EVENT_CODE=

# Slack Incoming Webhook for the channel that should receive contact and
# Campfire spec-ads form submissions. Keep this server-side secret unprefixed.
SLACK_FORM_SUBMISSIONS_WEBHOOK_URL=
