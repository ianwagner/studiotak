# Campfire free-spec-ads campaign form
# Create a Cloudflare Turnstile widget for your production domain and add its two keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=www.studiotak.co

# Resend email. RESEND_FROM_EMAIL must use a verified Resend domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Studio Tak <hello@studiotak.co>"
# Optional published Resend template used for the applicant thank-you email.
RESEND_APPLICATION_THANK_YOU_TEMPLATE_ID=

# Slack Incoming Webhook for the channel that should receive contact and
# Campfire spec-ads form submissions. Keep this server-side secret unprefixed.
SLACK_FORM_SUBMISSIONS_WEBHOOK_URL=
